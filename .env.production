# Deployment: github or cloudflare. Store CLOUDFLARE_API_TOKEN in Actions Secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=

# Public defaults only. Replace URL and repository before enabling Hub participation.
PUBLIC_HUB_REPOSITORY=

# Standard settings. Legacy content/site.json remains the site-copy fallback.
PUBLIC_RELEASE_LOCALE=en
PUBLIC_AI_MARKDOWN_ENABLED=true
PUBLIC_AI_LLMS_ENABLED=true

PUBLIC_RELATED_ENABLED=true

PUBLIC_RELATED_SHOW_THUMBNAIL=true

PUBLIC_RELATED_LIMIT=4

PUBLIC_ANALYTICS_ENABLED=true

# Generate user-blog speech by default; per-post tts/ttsVoice may override.
PUBLIC_TTS_ENABLED=true


# Search/AI policies match the shared template defaults.
PUBLIC_AI_CHATGPT_SEARCH_ENABLED=true
PUBLIC_AI_CLAUDE_SEARCH_ENABLED=true
PUBLIC_AI_GOOGLE_EXTENDED_ENABLED=true
PUBLIC_AI_OPENAI_TRAINING_ENABLED=true
PUBLIC_AI_ANTHROPIC_TRAINING_ENABLED=true
PUBLIC_GOOGLE_SEARCH_ENABLED=true
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_GOOGLE_SITE_VERIFICATION=
GITBLOG_DEPLOY_PROVIDER="github"
PUBLIC_SOURCE_LOCALE="ko"
PUBLIC_RELEASE_USE_TRANSLATIONS="false"
PUBLIC_SITE_TITLE="Gitblog's Blog"
PUBLIC_SITE_IMAGE="https://raw.githubusercontent.com/gitblogapp/gitblog-blog/main/static/uploads/blog/cfe0bf7fedba7e4bc24f5431b8cf8b8e0cdf5472a272d891f516f5dce580af92.webp"
PUBLIC_SITE_AUTHOR_TYPE="Organization"
PUBLIC_SITE_REPOSITORY="gitblogapp/gitblog-blog"
PUBLIC_HUB_URL="https://gitblog.app"
PUBLIC_HUB_ENABLED="true"
PUBLIC_GISCUS_REPO="gitblogapp/gitblog-blog"
PUBLIC_GISCUS_REPO_ID="R_kgDOVhFX6g"
PUBLIC_GISCUS_CATEGORY="Announcements"
PUBLIC_GISCUS_CATEGORY_ID="DIC_kwDOVhFX6s4DKRoj"
PUBLIC_GISCUS_HOST="https://gitblog.app"
PUBLIC_GISCUS_PROVIDER="gitblog"
PUBLIC_GISCUS_ENABLED="true"
PUBLIC_SITE_URL="https://blog.gitblog.page"
PUBLIC_SITE_OWNER="gitblog"
PUBLIC_SITE_AUTHOR="gitblog"
PUBLIC_SITE_FOOTER="Powerd by gitblog"
PUBLIC_TRANSLATION_LOCALES="ar,de,en,es,fr,it,ja,pt,pt-br,zh-hans,zh-hant"
PUBLIC_TTS_VOICE="F5"
PUBLIC_SOCIAL_GITHUB_URL="https://github.com/gitblogapp"
PUBLIC_SITE_TAGLINE="GitHub와 연결되는 나만의 블로그, GitBlog."
PUBLIC_SITE_DESCRIPTION="GitBlog는 GitHub를 기반으로 누구나 쉽고 빠르게 자신만의 블로그를 만들고 운영할 수 있는 플랫폼입니다. 간편한 설정과 자유로운 커스터마이징으로 개발 경험과 지식, 일상을 나만의 공간에 기록하고 공유해 보세요."
